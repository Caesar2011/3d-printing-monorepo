{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "outDir": "dist",
    "rootDir": "src",
    "declarationDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "stripInternal": true,
    "baseUrl": ".",
    "paths": {
      "@jsxcad/core": ["src"],
      "@jsxcad/core/*": ["src/*"]
    }
    // -------------------------

  },
  "references": [{ "path": "../reconciler" }, { "path": "../utils" }],
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}