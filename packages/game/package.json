{
  "name": "@jsxcad/game",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc-watch --onSuccess \"npm start\" --project tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "serve": "node --enable-source-maps dist/utils/server.js"
  },
  "dependencies": {
    "@jsxcad/core": "*",
    "@jsxcad/utils": "*",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "winston": "^3.17.0",
    "winston-console-format": "^1.0.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "tsc-watch": "^6.2.1",
    "tsx": "^3.12.7"
  }
}
