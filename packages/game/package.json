{
  "name": "@jsxcad/game",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc-watch --onSuccess \"npm start\" --project tsconfig.json",
