    "serve": "node --enable-source-maps dist/server.js"
  },
  "dependencies": {
    "@jsxcad/core": "*",
    "react": "^19.0.0",
    "@jscad/3mf-serializer": "^3.0.1-alpha.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "tsc-watch": "^6.2.1",
    "tsx": "^3.12.7",
    "@types/express": "^4.17.21"
  }
}
