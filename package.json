{
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.6.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "watch:anno": "tsc --build packages/anno --watch",
    "watch:paleo": "tsc --build packages/paleo --watch",
    "watch:skull-king": "tsc --build packages/skull-king --watch",
    "game:anno": "node scripts/dev-runner.ts anno",
    "game:paleo": "node scripts/dev-runner.ts paleo",
    "game:skull-king": "node scripts/dev-runner.ts skull-king",
    "serve": "yarn workspace @jsxcad/server serve",
    "dev:anno": "cross-env FORCE_COLOR=1 npm-run-all --parallel -l watch:anno serve game:anno",
    "dev:paleo": "cross-env FORCE_COLOR=1 npm-run-all --parallel -l watch:paleo serve game:paleo",
    "dev:skull-king": "cross-env FORCE_COLOR=1 npm-run-all --parallel -l watch:skull-king serve game:skull-king",
    "build": "node scripts/cleanup.ts && yarn workspaces foreach -A --topological-dev run build",
    "lint": "prettier --write . && eslint . --fix",
    "lint:eslint": "eslint . --fix",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.6",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.20.0",
    "@types/react": "^19.0.12",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint",
      "prettier"
    ]
  }
}
