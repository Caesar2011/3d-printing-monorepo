{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "watch:reconciler": "nodemon --watch packages/reconciler --ignore packages/reconciler/dist -e * --delay 50ms --exec \"npm run build --workspace=@jsxcad/reconciler\"",
    "watch:core": "nodemon --watch packages/core --ignore packages/core/dist -e * --delay 50ms --exec \"npm run build --workspace=@jsxcad/core\"",
    "watch:game": "nodemon --watch packages/game --ignore packages/game/dist -e * --delay 50ms --exec \"npm run build --workspace=@jsxcad/game\"",
    "watch:utils": "nodemon --watch packages/utils --ignore packages/game/utils -e * --delay 50ms --exec \"npm run build --workspace=@jsxcad/utils\"",
    "watch:anno": "nodemon --watch packages/anno --ignore packages/game/anno -e * --delay 50ms --exec \"npm run build --workspace=@jsxcad/anno\"",
    "game:anno": "nodemon --watch packages/reconciler/dist --watch packages/core/dist --watch packages/game/dist --watch packages/utils/dist --watch packages/anno/dist -e * --delay 500ms --exec \"npm start --workspace=@jsxcad/anno\"",
    "serve": "nodemon --watch packages/game/dist/server.js -e * --delay 500ms --exec \"npm run serve --workspace=@jsxcad/game\"",
    "dev": "cross-env FORCE_COLOR=1 npm-run-all --parallel -l watch:* serve game:anno",
    "lint": "prettier --write . && eslint . --fix",
    "lint:eslint": "eslint . --fix",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/react": "^19.0.12",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "@eslint/compat": "^1.2.6",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.20.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.1",
    "typescript-eslint": "^8.24.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-import-resolver-typescript": "^4.2.2"
  },
  "dependencies": {},
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint",
      "prettier"
    ]
  }
}
